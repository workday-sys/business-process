<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hire / Rehire – Staff &amp; Faculty Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0f2040;
    --navy-mid: #1a3460;
    --blue: #1e5fa8;
    --blue-light: #2e7dd1;
    --gold: #e8a922;
    --gold-light: #f5c84a;
    --teal: #0e8a7a;
    --red: #c0392b;
    --green: #1a7a4a;
    --slate: #4a5568;
    --light: #f4f7fb;
    --white: #ffffff;
    --border: #dde4ef;
    --card-shadow: 0 4px 24px rgba(15,32,64,0.10);
    --role-hr: #2e7dd1;
    --role-budget: #e8a922;
    --role-payroll: #0e8a7a;
    --role-manager: #7c3aed;
    --role-tk: #d97706;
    --role-admin: #64748b;
    --role-employee: #c0392b;
    --role-tta: #0e6060;
    --role-comp: #be185d;
    --role-academic: #92400e;
    --role-recruit: #0369a1;
    --role-system: #475569;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--light); color: var(--navy); min-height: 100vh; }

  /* HEADER */
  .header {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 60%, var(--blue) 100%);
    color: white; padding: 36px 48px 28px; position: relative; overflow: hidden;
  }
  .header::before {
    content: ''; position: absolute; top: -60px; right: -60px; width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(232,169,34,0.18) 0%, transparent 70%); border-radius: 50%;
  }
  .header::after {
    content: ''; position: absolute; bottom: -40px; left: 30%; width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(46,125,209,0.2) 0%, transparent 70%); border-radius: 50%;
  }
  .header-inner { position: relative; z-index: 1; }
  .header h1 { font-family: 'DM Serif Display', serif; font-size: 2.2rem; letter-spacing: -0.5px; margin-bottom: 6px; }
  .header p { color: rgba(255,255,255,0.72); font-size: 0.95rem; font-weight: 400; }
  .header-badge {
    display: inline-block; background: var(--gold); color: var(--navy);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 3px 10px; border-radius: 20px; margin-bottom: 12px;
  }

  /* TABS */
  .tabs-bar {
    background: var(--white); border-bottom: 2px solid var(--border); padding: 0 48px;
    display: flex; gap: 4px; overflow-x: auto; position: sticky; top: 0; z-index: 100;
    box-shadow: 0 2px 12px rgba(15,32,64,0.07);
  }
  .tab-btn {
    padding: 16px 18px; font-family: 'DM Sans', sans-serif; font-size: 0.83rem; font-weight: 600;
    color: var(--slate); background: none; border: none; border-bottom: 3px solid transparent;
    cursor: pointer; white-space: nowrap; transition: all 0.2s; position: relative; top: 2px;
  }
  .tab-btn:hover { color: var(--blue); }
  .tab-btn.active { color: var(--blue); border-bottom-color: var(--blue); }

  /* CONTENT */
  .content { max-width: 1200px; margin: 0 auto; padding: 36px 48px 60px; }
  .section { display: none; }
  .section.active { display: block; }

  /* CARDS */
  .card { background: var(--white); border-radius: 16px; box-shadow: var(--card-shadow); padding: 32px; margin-bottom: 28px; border: 1px solid var(--border); }
  .card-title { font-family: 'DM Serif Display', serif; font-size: 1.35rem; color: var(--navy); margin-bottom: 6px; }
  .card-subtitle { font-size: 0.82rem; color: var(--slate); margin-bottom: 22px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.8px; }

  /* OVERVIEW GRID */
  .overview-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 28px; }
  .overview-tile {
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
    color: white; border-radius: 14px; padding: 22px 20px; cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s; border: 2px solid transparent;
    position: relative; overflow: hidden;
  }
  .overview-tile::after { content: ''; position: absolute; bottom: -20px; right: -20px; width: 80px; height: 80px; background: rgba(255,255,255,0.06); border-radius: 50%; }
  .overview-tile:hover { transform: translateY(-3px); box-shadow: 0 8px 32px rgba(15,32,64,0.18); }
  .overview-tile:nth-child(2) { background: linear-gradient(135deg, #5b2a00 0%, #c06a10 100%); }
  .overview-tile:nth-child(3) { background: linear-gradient(135deg, #1a4a2e 0%, var(--teal) 100%); }
  .overview-tile:nth-child(4) { background: linear-gradient(135deg, #2d1060 0%, var(--role-manager) 100%); }
  .tile-icon { font-size: 1.8rem; margin-bottom: 10px; }
  .tile-name { font-weight: 700; font-size: 0.95rem; margin-bottom: 4px; }
  .tile-desc { font-size: 0.78rem; opacity: 0.8; line-height: 1.5; }

  /* FLOWCHART */
  .flowchart { display: flex; flex-direction: column; align-items: center; gap: 0; padding: 10px 0; }
  .flow-node { position: relative; width: 100%; max-width: 640px; }
  .flow-box {
    border-radius: 10px; padding: 14px 22px; font-size: 0.88rem; font-weight: 500;
    text-align: center; position: relative; border: 2px solid transparent; transition: transform 0.15s;
  }
  .flow-box:hover { transform: scale(1.02); }
  .flow-start { background: var(--navy); color: white; border-radius: 30px; font-weight: 700; letter-spacing: 0.5px; padding: 12px 32px; }
  .flow-end { background: var(--teal); color: white; border-radius: 30px; font-weight: 700; letter-spacing: 0.5px; padding: 12px 32px; }
  .flow-end.denied { background: var(--red); }
  .flow-action { background: #eef3fb; border-color: var(--role-hr); color: var(--navy); }
  .flow-action.budget { background: #fef8ec; border-color: var(--gold); }
  .flow-action.payroll { background: #edfaf7; border-color: var(--teal); }
  .flow-action.manager { background: #f5f0ff; border-color: var(--role-manager); }
  .flow-action.employee { background: #fef2f2; border-color: var(--role-employee); }
  .flow-action.tk { background: #fff7ed; border-color: var(--role-tk); }
  .flow-action.tta { background: #ecfdfb; border-color: var(--role-tta); }
  .flow-action.comp { background: #fdf1f6; border-color: var(--role-comp); }
  .flow-action.academic { background: #fdf5ec; border-color: var(--role-academic); }
  .flow-action.recruit { background: #eef8ff; border-color: var(--role-recruit); }
  .flow-action.system { background: #f1f4f8; border-color: var(--role-system); }
  .flow-decision { background: #fff8e1; border: 2px dashed var(--gold); border-radius: 8px; color: var(--navy); font-style: italic; font-size: 0.84rem; padding: 12px 20px; }
  .flow-skip { background: #f8f9fb; border: 2px dotted #b7c0cf; border-radius: 8px; color: var(--slate); font-size: 0.8rem; padding: 8px 18px; font-style: italic; }
  .flow-connector { display: flex; flex-direction: column; align-items: center; height: 36px; justify-content: center; color: var(--slate); font-size: 1.3rem; position: relative; }
  .flow-connector::before { content: ''; width: 2px; height: 100%; background: var(--border); position: absolute; }
  .flow-connector span { background: white; padding: 0 4px; position: relative; z-index: 1; font-size: 1.1rem; color: var(--slate); }
  .flow-label { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; font-size: 0.75rem; color: var(--slate); font-weight: 600; text-transform: uppercase; letter-spacing: 0.7px; justify-content: center; }
  .role-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  .role-dot.hr { background: var(--role-hr); }
  .role-dot.budget { background: var(--role-budget); }
  .role-dot.payroll { background: var(--role-payroll); }
  .role-dot.manager { background: var(--role-manager); }
  .role-dot.admin { background: var(--role-admin); }
  .role-dot.employee { background: var(--role-employee); }
  .role-dot.tk { background: var(--role-tk); }
  .role-dot.tta { background: var(--role-tta); }
  .role-dot.comp { background: var(--role-comp); }
  .role-dot.academic { background: var(--role-academic); }
  .role-dot.recruit { background: var(--role-recruit); }
  .role-dot.system { background: var(--role-system); }

  /* DECISION BRANCH */
  .decision-branch { display: flex; gap: 18px; width: 100%; max-width: 820px; justify-content: center; flex-wrap: wrap; }
  .branch-side { flex: 1; min-width: 260px; display: flex; flex-direction: column; align-items: center; gap: 0; }
  .branch-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--slate); margin-bottom: 6px; background: var(--light); padding: 2px 10px; border-radius: 20px; }

  /* ROLES TABLE */
  .roles-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .roles-table th { background: var(--navy); color: white; padding: 12px 14px; text-align: left; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; }
  .roles-table th:first-child { border-radius: 8px 0 0 0; }
  .roles-table th:last-child { border-radius: 0 8px 0 0; }
  .roles-table td { padding: 11px 14px; border-bottom: 1px solid var(--border); vertical-align: top; line-height: 1.5; font-size: 0.82rem; }
  .roles-table tr:hover td { background: #f8faff; }
  .roles-table tr:last-child td { border-bottom: none; }
  .check { color: var(--green); font-size: 1rem; }
  .dash { color: #ccc; font-size: 1rem; }

  .role-tag { display: inline-block; font-size: 0.71rem; font-weight: 700; padding: 2px 9px; border-radius: 20px; margin: 2px; white-space: nowrap; }
  .role-tag.hr { background: #ddeeff; color: var(--blue); }
  .role-tag.budget { background: #fff3cc; color: #7a5800; }
  .role-tag.payroll { background: #d9f5ef; color: var(--teal); }
  .role-tag.manager { background: #ede9ff; color: #5b21b6; }
  .role-tag.admin { background: #f1f5f9; color: var(--slate); }
  .role-tag.employee { background: #fee2e2; color: #991b1b; }
  .role-tag.tk { background: #fef3c7; color: #92400e; }
  .role-tag.tta { background: #d1faf4; color: #065f46; }
  .role-tag.comp { background: #fce7f0; color: var(--role-comp); }
  .role-tag.academic { background: #fdecd6; color: var(--role-academic); }
  .role-tag.recruit { background: #dceeff; color: var(--role-recruit); }
  .role-tag.system { background: #e6eaf0; color: var(--role-system); }

  /* FLAGS */
  .flag { display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px; border-radius: 10px; margin-bottom: 12px; font-size: 0.87rem; line-height: 1.6; }
  .flag.decision { background: #fff8e1; border-left: 4px solid var(--gold); }
  .flag.condition { background: #edfaf7; border-left: 4px solid var(--teal); }
  .flag.warning { background: #fef2f2; border-left: 4px solid #ef4444; }
  .flag.info { background: #eff6ff; border-left: 4px solid var(--blue); }
  .flag-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }
  .flag strong { color: var(--navy); display: block; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px; }

  /* TWO-COL */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 24px; }
  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }
  .section-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--slate); margin-bottom: 12px; }
  .who-list { list-style: none; }
  .who-list li { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.87rem; }
  .who-list li:last-child { border-bottom: none; }

  /* PROCESS HEADER */
  .process-header { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 28px; padding-bottom: 22px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  .process-icon-big { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0; }
  .process-icon-big.blue { background: linear-gradient(135deg, var(--navy), var(--blue)); }
  .process-icon-big.teal { background: linear-gradient(135deg, #065f46, var(--teal)); }
  .process-icon-big.orange { background: linear-gradient(135deg, #7c2d12, #ea580c); }
  .process-icon-big.purple { background: linear-gradient(135deg, #3b0764, var(--role-manager)); }
  .process-meta { flex: 1; }
  .process-meta h2 { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: var(--navy); margin-bottom: 4px; }
  .process-meta p { font-size: 0.85rem; color: var(--slate); }
  .completion-badge { background: var(--light); border: 1px solid var(--border); border-radius: 10px; padding: 10px 16px; font-size: 0.78rem; color: var(--slate); text-align: center; flex-shrink: 0; }
  .completion-badge strong { display: block; font-size: 0.92rem; color: var(--navy); margin-top: 4px; }

  /* PRINT */
  @media print {
    .tabs-bar { display: none !important; }
    .section { display: block !important; page-break-before: always; }
    .section:first-of-type { page-break-before: auto; }
  }
  @media (max-width: 700px) {
    .header { padding: 24px 20px 18px; }
    .tabs-bar { padding: 0 8px; }
    .content { padding: 20px 16px 40px; }
  }
</style>
</head>
<body>

<div class="header">
  <div class="header-inner">
    <div class="header-badge">Business Process · TAM Scope</div>
    <h1>Hire / Rehire – Staff &amp; Faculty Dashboard</h1>
    <p>Interactive guide to the Hire/Rehire workflow — roles, steps, decisions, and approvals · Federal Work Study &amp; State positions excluded</p>
  </div>
</div>

<div class="tabs-bar">
  <button class="tab-btn active" onclick="showTab('overview')">📋 Overview</button>
  <button class="tab-btn" onclick="showTab('bp1')">🚀 Initiate Hire</button>
  <button class="tab-btn" onclick="showTab('bp2')">💰 Budget &amp; Approvals</button>
  <button class="tab-btn" onclick="showTab('bp3')">🪪 Personal Info &amp; Completion</button>
  <button class="tab-btn" onclick="showTab('bp4')">🎓 Post-Completion &amp; Onboarding</button>
  <button class="tab-btn" onclick="showTab('roles')">👥 Roles &amp; Permissions</button>
</div>

<div class="content">

<!-- ══════ OVERVIEW ══════ -->
<div id="overview" class="section active">
  <div class="card">
    <div class="card-title">Hire / Rehire at a Glance</div>
    <div class="card-subtitle">1 End-to-End Business Process · 4 Phases · 22 Steps · City Positions Only</div>
    <div class="overview-grid">
      <div class="overview-tile" onclick="showTab('bp1')">
        <div class="tile-icon">🚀</div>
        <div class="tile-name">Initiate Hire</div>
        <div class="tile-desc">HR Partner (or automatically via Recruiting) starts the hire, background check, org assignments, compensation, and pay group.</div>
      </div>
      <div class="overview-tile" onclick="showTab('bp2')">
        <div class="tile-icon">💰</div>
        <div class="tile-name">Budget &amp; Approvals</div>
        <div class="tile-desc">Position budget and city payroll data are entered, then routed through budget check and consolidated approvals.</div>
      </div>
      <div class="overview-tile" onclick="showTab('bp3')">
        <div class="tile-icon">🪪</div>
        <div class="tile-name">Personal Info &amp; Completion</div>
        <div class="tile-desc">Personal data, government IDs, and other IDs are finalized. Process completes on Payroll Partner's final approval.</div>
      </div>
      <div class="overview-tile" onclick="showTab('bp4')">
        <div class="tile-icon">🎓</div>
        <div class="tile-name">Post-Completion &amp; Onboarding</div>
        <div class="tile-desc">Contract document, Workday account, academic appointment, probation, and onboarding all occur after the person is already hired.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Security Roles Legend</div>
    <div class="card-subtitle">Who participates across the Hire/Rehire process</div>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px;">
      <span class="role-tag hr">🔵 HR Partner</span>
      <span class="role-tag admin">⚪ HR Administrator</span>
      <span class="role-tag admin">⚪ HR Specialist</span>
      <span class="role-tag recruit">🔷 Recruiter</span>
      <span class="role-tag recruit">🔷 Recruiting Administrator</span>
      <span class="role-tag manager">🟣 Manager</span>
      <span class="role-tag payroll">🌊 Payroll Partner</span>
      <span class="role-tag payroll">🌊 Payroll Administrator</span>
      <span class="role-tag budget">🟡 Budget Manager</span>
      <span class="role-tag comp">🌸 Compensation Partner</span>
      <span class="role-tag academic">🟤 Academic Faculty Partner</span>
      <span class="role-tag employee">🔴 Employee</span>
      <span class="role-tag system">⚙️ Workday Service (System)</span>
    </div>
    <div class="flag info">
      <span class="flag-icon">ℹ️</span>
      <div><strong>Multiple Roles Per Person</strong>A person can wear multiple hats — an HR Partner could also be a Compensation Partner or Budget Manager elsewhere. Roles are assigned per organization, not exclusive.</div>
    </div>
    <div class="flag decision">
      <span class="flag-icon">⚠️</span>
      <div><strong>Direct Hire vs. Recruiting-Sourced Hire</strong>A Direct Hire requires the HR Partner to create a Pre-Hire record and start a background check. A hire sourced through Recruiting arrives in the HR Partner's inbox automatically once a candidate is marked "Ready for Hire," and the background check step is skipped since it was already completed.</div>
    </div>
    <div class="flag condition">
      <span class="flag-icon">🔀</span>
      <div><strong>Full-Time vs. Part-Time — Different Approval Paths</strong>Full-time positions route through a Payroll Partner budget check. Part-time (e.g. adjunct) positions skip that check and instead route to a Budget Manager for consolidated approval, who also reviews appointment/professional hours.</div>
    </div>
    <div class="flag condition">
      <span class="flag-icon">🔀</span>
      <div><strong>Self-Initiated vs. Initiated by Another</strong>If the HR Partner or Compensation Partner completing a consolidated approval is the same person who initiated the hire, that approval step is automatically skipped.</div>
    </div>
    <div class="flag warning">
      <span class="flag-icon">🚫</span>
      <div><strong>Excluded from this Dashboard</strong>Federal Work Study positions and State-specific payroll steps have been excluded. All flows shown apply to City positions only.</div>
    </div>
  </div>
</div>

<!-- ══════ BP1: INITIATE HIRE ══════ -->
<div id="bp1" class="section">
  <div class="card">
    <div class="process-header">
      <div class="process-icon-big blue">🚀</div>
      <div class="process-meta">
        <h2>Phase 1 — Initiate Hire</h2>
        <p>Initiated by HR Partner · HR Administrator · HR Specialist · Manager · Recruiter · Recruiting Administrator</p>
      </div>
      <div class="completion-badge">Phase Ends At<strong>Assign Pay Group</strong></div>
    </div>

    <div class="two-col">
      <div>
        <div class="section-label">Who is Involved</div>
        <ul class="who-list">
          <li><span class="role-dot hr"></span><span class="role-tag hr">HR Partner</span> Creates Pre-Hire, starts background check, changes org assignments &amp; compensation</li>
          <li><span class="role-dot recruit"></span><span class="role-tag recruit">Recruiter / Recruiting Admin</span> Marks candidate "Ready for Hire" (Recruiting path)</li>
          <li><span class="role-dot manager"></span><span class="role-tag manager">Manager</span> Can be an initiator depending on security setup</li>
          <li><span class="role-dot payroll"></span><span class="role-tag payroll">Payroll Partner</span> Assigns pay group (if not automatic)</li>
        </ul>
      </div>
      <div>
        <div class="section-label">Decision Flags</div>
        <div class="flag decision">
          <span class="flag-icon">⚠️</span>
          <div><strong>Background Check Only for Direct Hire</strong>If sourced from Recruiting, the background check step is skipped — it was already completed during recruiting.</div>
        </div>
        <div class="flag condition">
          <span class="flag-icon">🔀</span>
          <div><strong>One-Time Payment is Optional</strong>Not required for every hire. Skippable via the gear icon &gt; Skip if there's no hiring bonus or similar one-time payment.</div>
        </div>
      </div>
    </div>

    <div class="card-title" style="font-size:1rem;margin-bottom:18px;">Flowchart — Initiate Hire</div>
    <div class="flowchart">
      <div class="flow-node">
        <div class="flow-box flow-start">🚀 START — Pre-Hire Created or Candidate Marked "Ready for Hire"</div>
      </div>
      <div class="flow-connector"><span>↓</span></div>
      <div class="flow-node">
        <div class="flow-box flow-decision">⚠️ Decision: Direct Hire or Sourced via Recruiting?</div>
      </div>
      <div class="flow-connector"><span>↓</span></div>
      <div class="decision-branch">
        <div class="branch-side">
          <div class="branch-label">✅ Direct Hire</div>
          <div class="flow-connector"><span>↓</span></div>
          <div class="flow-node">
            <div class="flow-label"><span class="role-dot hr"></span> HR Partner</div>
            <div class="flow-box flow-action hr">Start a Background Check<br><small style="opacity:0.65">Only for Direct Hire</small></div>
          </div>
        </div>
        <div class="branch-side">
          <div class="branch-label">🔷 Sourced via Recruiting</div>
          <div class="flow-connector"><span>↓</span></div>
          <div class="flow-node">
            <div class="flow-box flow-skip">Background Check Skipped — Already Completed in Recruiting</div>
          </div>
        </div>
      </div>
      <div class="flow-connector"><span>↓</span></div>
      <div class="flow-node">
        <div class="flow-label"><span class="role-dot hr"></span> HR Partner</div>
        <div class="flow-box flow-action hr">Request One-Time Payment<br><small style="opacity:0.65">Optional — skippable via gear icon</small></div>
      </div>
      <div class="flow-connector"><span>↓</span></div>
      <div class="flow-node">
        <div class="flow-label"><span class="role-dot hr"></span> HR Partner</div>
        <div class="flow-box flow-action hr">Change Organization Assignments</div>
      </div>
      <div class="flow-connector"><span>↓</span></div>
      <div class="flow-node">
        <div class="flow-label"><span class="role-dot hr"></span> HR Partner</div>
